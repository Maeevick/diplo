{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Diplo",
	"version": "0.1.0",
	"identifier": "com.maeevick.diplo",
	"build": {
		"beforeDevCommand": { "script": "trunk serve", "cwd": "../game" },
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": { "script": "trunk build --release --cargo-profile web-release", "cwd": "../game" },
		"frontendDist": "../game/dist"
	},
	"app": {
		"windows": [{ "title": "Diplo", "width": 450, "height": 800 }],
		"security": { "csp": null }
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
